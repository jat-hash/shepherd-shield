{
  "name": "Alert on Property Checklist Complete",
  "description": "When a property security check is recorded, evaluates whether all active property posts are checked for the current cycle and alerts Ryan, Pacheco, and admins once the Marathon Property Checklist is complete.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "PropertySecurityCheck"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alert_on_property_checklist_complete",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPropertyChecklistComplete",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyPropertyChecklistComplete"
  }
}