{
  "name": "Assignment Reminder 1 Hour Before Shift",
  "description": "Reminds every member with a service assignment about an hour before their shift starts. Runs every 5 minutes in Pacific time.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "America/Los_Angeles",
      "interval_value": 5,
      "interval_unit": "minutes",
      "interval_anchor": "2026-10-26T02:10:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "assignment_reminder_one_hour_before",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "remind_assignee": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "checkHourBeforeAssignmentReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send 1-hour reminders",
            "description": "To everyone assigned today"
          }
        }
      }
    ]
  }
}